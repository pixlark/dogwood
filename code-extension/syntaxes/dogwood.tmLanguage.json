{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Dogwood",
  "scopeName": "source.dogwood",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#literals" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.hash.dogwood",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.dogwood",
          "match": "\\b(if|else|switch|return|loop|break|where)\\b"
        },
        {
          "name": "keyword.declaration.dogwood",
          "match": "\\b(let|fn|struct|union|enum|typeclass|instance)\\b"
        },
        {
          "name": "keyword.operator.dogwood",
          "match": "\\b(new|cast|builtin)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.dogwood",
          "match": "\\b(void|arr|bool|int|any)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.dogwood",
          "match": "\\b(true|false|undefined)\\b"
        },
        {
          "name": "constant.numeric.dogwood",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.dogwood",
          "match": "==|!=|>=|<=|>|<"
        },
        {
          "name": "keyword.operator.logical.dogwood",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arrow.dogwood",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.assignment.dogwood",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.dogwood",
          "match": "[+\\-*/%&]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.dogwood",
          "match": "::|:|;|,"
        },
        {
          "name": "punctuation.bracket.dogwood",
          "match": "[\\[\\]{}()]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.dogwood",
          "match": "\\b[a-zA-Z_][a-zA-Z_]*\\b"
        }
      ]
    }
  }
}
