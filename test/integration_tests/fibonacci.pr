let main = fn() {
    fib(20);
};

let fib = fn(n: int) -> int {
    let print = builtin print;

    let a = 0;
    let b = 1;

    loop {
        if n == 0 {
            break;
        }

        print(a);

        let tmp = a;
        a = b;
        b = tmp + b;

        n = n - 1;
    }

    a
};
