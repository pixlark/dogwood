cabal-version:      3.0
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.

-- Initial package description 'c-interop-prototype2' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name:               dogwood

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.0.0

-- A short (one-line) description of the package.
synopsis:           Experimental compiler

-- A longer description of the package.
description:        Experimental compiler for the dogwood language

-- The package author(s).
author:             Brooke Tilley

-- An email address to which users can send suggestions, bug reports, and patches.
maintainer:         brooke.tilley.2k@gmail.com

-- A copyright notice.
-- copyright:
build-type:         Simple

-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
-- extra-doc-files:    CHANGELOG.md

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- extra-source-files:

category:           compiler

common warnings
    ghc-options: -Wall
                 -Wno-missing-signatures
                 -Wno-name-shadowing
                 -Wno-unused-imports
                 -- ^ this flag should get removed every once in a while to clean up the imports
                 --   however, having it on all the time adds so much warning noise
                 -Wno-ambiguous-fields
common extensions
    default-extensions:
        -- Pretty uncontroversial syntax extensions
        BlockArguments
        LambdaCase
        MultiWayIf
        ImportQualifiedPost
        -- Make records more usable
        DuplicateRecordFields
        OverloadedRecordDot
        NamedFieldPuns
        -- Basically required for Data.Text
        OverloadedStrings
        -- Required for effectful, which we use everywhere
        DataKinds
        FlexibleContexts
        TypeOperators
        -- These make it easier to write type signatures everywhere
        InstanceSigs
        ScopedTypeVariables

source-repository head
    type:             git
    location:         https://github.com/pixlark/dogwood

library dogwood-core
    import:           warnings, extensions
    exposed-modules:
        -- Frontend
        DW.Frontend, DW.Config,
        -- Compiler passes
        DW.Lexer,
            DW.Lexer.Internal,
        DW.Parser,
            DW.Parser.Internal,
        DW.ConstExprPass,
        DW.LowerPass,
        DW.NameResolutionPass,
            DW.NameResolutionPass.Names,
        DW.Typechecker,
            DW.Typechecker.Internal,
        DW.LoopPass,
        DW.Compiler,
            DW.Compiler.Internal,
            DW.Compiler.Internal.Users,
            DW.Compiler.Internal.Compiler,
            DW.Compiler.Internal.Types,
            DW.Compiler.Internal.Lenses,
        DW.EmitC,
            DW.EmitC.Internal.EmitEffect,
        DW.Clang,
        -- Representations
        DW.AST,
            DW.AST.Visit,
        DW.LoweredAST,
        DW.NamedAST,
        DW.TypedAST,
            DW.TypedAST.Visit,
        DW.IR,
        -- Utility
        DW.Common, DW.Util, DW.LexicalScopes, DW.Lens,
        -- Logging
        DW.Logging,
        -- Error handling
        DW.Error,
            DW.Error.Internal,
            DW.Error.Internal.Err,
            DW.Error.Internal.ICE,
            DW.Error.Internal.Display,
            DW.Error.Internal.ErrorsEffect,
        -- Language server
        DW.LSP,
        -- Misc
        DW.UnifyTest.Internal,
    build-depends:    base                  ^>=4.18,
                      aeson                 ^>=2.2,
                      containers            ^>=0.6,
                      directory             ^>=1.3,
                      effectful-core        ^>=2.6,
                      effectful-plugin      ^>=2.1,
                      hashable              ^>=1.5,
                      lsp                   ^>=2.8,
                      mtl                   ^>=2.3,
                      neat-interpolation    ^>=0.5,
                      optics                ^>=0.4,
                      process               ^>=1.6,
                      sorted-list           ^>=0.3,
                      text                  ^>=2.1,
                      text-format           ^>=0.3,
                      transformers          ^>=0.6,
                      unordered-containers  ^>=0.2,
    hs-source-dirs:   src
    default-language: Haskell2010
    ghc-options:      -fplugin=Effectful.Plugin

test-suite dogwood-tests
    import:           warnings, extensions
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    other-modules:
        ErrorsSpec,
        LexerSpec,
        ParserSpec,
        LowerPassSpec,
        NameResolutionSpec,
        TypecheckerSpec,
        LoopPassSpec,
        CompilerSpec,
        EmitCSpec,
        IntegrationSpec,
        TestUtil,
        UnifyTestSpec,
    build-depends:    base                  ^>=4.18.3.0,
                      directory             ^>=1.3,
                      dogwood-core          ^>=0.1,
                      effectful-core        ^>=2.6,
                      effectful-plugin      ^>=2.1,
                      filepath              ^>=1.4,
                      hspec                 ^>=2.11,
                      monad-loops           ^>=0.4,
                      mtl                   ^>=2.3,
                      neat-interpolation    ^>=0.5,
                      process               ^>=1.6,
                      text                  ^>=2.1,
    default-language: Haskell2010
    ghc-options:      -fplugin=Effectful.Plugin

executable dogwood
    import:           warnings, extensions
    main-is:          Main.hs
    build-depends:    base                  ^>=4.18,
                      text                  ^>=2.1,
                      mtl                   ^>=2.3,
                      transformers          ^>=0.6,
                      dogwood-core          ^>=0.1,
                      neat-interpolation    ^>=0.5,
                      effectful-core        ^>=2.6,
                      optparse-applicative  ^>=0.19,
    hs-source-dirs:   app
    default-language: Haskell2010

executable dogwood-bench
    import:           warnings
    default-extensions:
        BlockArguments
        ImportQualifiedPost
        OverloadedStrings
    main-is:          Main.hs
    build-depends:    base                  ^>=4.18,
                      criterion             ^>=1.6,
                      deepseq               ^>=1.4,
                      dogwood-core          ^>=0.1,
                      filepath              ^>=1.4,
                      neat-interpolation    ^>=0.5,
                      text                  ^>=2.1,
    hs-source-dirs:   bench
    default-language: Haskell2010
